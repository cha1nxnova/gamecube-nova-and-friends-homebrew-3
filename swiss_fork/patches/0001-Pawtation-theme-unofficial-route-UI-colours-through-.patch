@@ -0,0 +1,47 @@
+/* -----------------------------------------------------------
+      pawtation_theme.h - colours of the private, unofficial
+      "Pawtation" theme (Cosmic palette). Not part of Swiss and
+      not supported by the Swiss project.
+
+      Every macro is a compound literal in the same form as the
+      stock code, so it also works as a static initialiser.
+      The stock value is noted after each line.
+   ----------------------------------------------------------- */
+
+#ifndef PAWTATION_THEME_H
+#define PAWTATION_THEME_H
+
+#include <gccore.h>
+
+/* Text */
+#define PAW_TEXT               (GXColor) {241,239,248,255}  /* {255,255,255,255} */
+#define PAW_TEXT_A(a)          (GXColor) {241,239,248,(a)}  /* {255,255,255,a} */
+#define PAW_TEXT_DISABLED      (GXColor) {129,120,156,255}  /* {175,175,182,255} */
+#define PAW_TEXT_DESELECTED    (GXColor) {140,130,170,255}  /* {80,80,73,255} */
+
+/* Panels (a = GUI_MSGBOX_ALPHA at the call sites) */
+#define PAW_PANEL_FILL(a)      (GXColor) {36,29,64,(a)}     /* {0,0,0,a} */
+#define PAW_PANEL_BORDER(a)    (GXColor) {209,79,152,(a)}   /* {200,200,200,a} */
+#define PAW_CARD_FILL          (GXColor) {23,18,43,128}     /* {0,0,0,128} */
+#define PAW_TITLEBAR_FILL      (GXColor) {17,12,36,160}     /* {0,0,0,128} */
+#define PAW_MENUBAR_FILL       (GXColor) {255,79,163,51}    /* {255,255,255,51} */
+
+/* Selection */
+#define PAW_SELECT_FILL(a)     (GXColor) {176,38,112,(a)}   /* {96,107,164,a} buttons, keys */
+#define PAW_SELECT_ROW(a)      (GXColor) {176,38,112,(a)}   /* {46,57,104,a} file rows */
+#define PAW_SCROLL_THUMB(a)    (GXColor) {255,79,163,(a)}   /* {46,57,104,a} */
+#define PAW_MENU_GLOW          (GXColor) {255,79,163,255}   /* {127,134,255,255} */
+
+/* Progress */
+#define PAW_PROGRESS(a)        (GXColor) {255,79,163,(a)}   /* {255,128,0,a} */
+#define PAW_PROGRESS_IND(a)    (GXColor) {95,169,242,(a)}   /* {0xb3,0xd9,0xff,a} */
+
+/* Tooltip */
+#define PAW_TOOLTIP_BORDER(a)  (GXColor) {255,79,163,(a)}   /* {255,255,255,a} */
+#define PAW_TOOLTIP_TEXT(a)    (GXColor) {241,239,248,(a)}  /* {255,255,255,a} */
+#define PAW_TOOLTIP_FILL(a)    (GXColor) {50,40,85,(a)}     /* {122,122,122,a} */
+
+/* Backdrop TEV channel selector for IA8-palette art (see _DrawImageNow) */
+#define PAW_BACKDROP_SELECT    (GXColor) {255,0,255,255}    /* {0,0,255,255} */
+
+#endif
