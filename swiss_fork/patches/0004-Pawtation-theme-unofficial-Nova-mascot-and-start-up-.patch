diff --git a/cube/swiss/source/gui/pawtation.c b/cube/swiss/source/gui/pawtation.c
new file mode 100644
index 00000000..55e43676
--- /dev/null
+++ b/cube/swiss/source/gui/pawtation.c
@@ -0,0 +1,121 @@
+/* -----------------------------------------------------------
+      pawtation.c - mascot and start-up quip of the private,
+      unofficial "Pawtation" theme. Not part of Swiss and not
+      supported by the Swiss project.
+
+      One read at boot of <boot device>/pawtation/quips.txt
+      (plain ASCII, one quip per line, written by the Pawtation
+      desktop app). Bounded: at most PAW_QUIPS_READ_MAX bytes,
+      PAW_QUIPS_LINES lines and PAW_QUIP_CHARS characters per
+      line; no heap; anything odd -> built-in quip.
+   ----------------------------------------------------------- */
+
+#include <string.h>
+#include <time.h>
+#include <gccore.h>
+#include <ogc/lwp_watchdog.h>
+#include "deviceHandler.h"
+#include "files.h"
+#include "pawtation.h"
+
+static const char *paw_builtin[] = {
+	"Nova says: take with food, play with friends.",
+	"Nova counted the discs. Twice. All present.",
+	"Snacks loaded. Discs spinning. Nova approves.",
+	"Nova checked the label: ready to play.",
+};
+#define PAW_BUILTIN_COUNT (sizeof(paw_builtin) / sizeof(paw_builtin[0]))
+
+static char paw_buf[PAW_QUIPS_READ_MAX + 1];
+static char paw_quip[PAW_QUIP_CHARS + 1];
+static file_handle paw_file;
+// Published with one aligned store once paw_quip is complete; read by the video thread.
+static const char * volatile paw_quip_ptr = NULL;
+
+const char *paw_quip_current(void) {
+	const char *quip = paw_quip_ptr;
+	return quip ? quip : paw_builtin[0];
+}
+
+static int paw_is_text(const char *buf, int len) {
+	int bad = 0;
+	for(int i = 0; i < len; i++) {
+		unsigned char c = buf[i];
+		if(c == 0) return 0;
+		if((c < 0x20 || c > 0x7E) && c != '\r' && c != '\n' && c != '\t') bad++;
+	}
+	return bad * 8 <= len;
+}
+
+// Copy one line into dst: printable ASCII only (tab -> space), trimmed, at most PAW_QUIP_CHARS.
+static int paw_clean_line(char *dst, const char *src, int len) {
+	int n = 0;
+	for(int i = 0; i < len && n < PAW_QUIP_CHARS; i++) {
+		unsigned char c = src[i];
+		if(c == '\t') c = ' ';
+		if(c < 0x20 || c > 0x7E) continue;
+		if(c == ' ' && (n == 0 || dst[n-1] == ' ')) continue;
+		dst[n++] = c;
+	}
+	while(n > 0 && dst[n-1] == ' ') n--;
+	dst[n] = '\0';
+	return n;
+}
+
+// Split paw_buf into lines; skip blank lines and '#' comments. Returns the number found.
+static int paw_scan_lines(int len, const char **starts, int *lens) {
+	int count = 0, i = 0;
+	while(i < len && count < PAW_QUIPS_LINES) {
+		int s = i;
+		while(i < len && paw_buf[i] != '\r' && paw_buf[i] != '\n') i++;
+		int e = i;
+		while(i < len && (paw_buf[i] == '\r' || paw_buf[i] == '\n')) i++;
+		while(s < e && (paw_buf[s] == ' ' || paw_buf[s] == '\t')) s++;
+		if(s == e || paw_buf[s] == '#') continue;
+		char probe[PAW_QUIP_CHARS + 1];
+		if(!paw_clean_line(probe, &paw_buf[s], e - s)) continue;
+		starts[count] = &paw_buf[s];
+		lens[count] = e - s;
+		count++;
+	}
+	return count;
+}
+
+void paw_init(DEVICEHANDLER_INTERFACE *device) {
+	u32 seed = (u32)gettime() ^ (u32)time(NULL);
+	const char *starts[PAW_QUIPS_LINES];
+	int lens[PAW_QUIPS_LINES];
+	int count = 0;
+
+	if(device && device->initial && device->readFile && device->seekFile && device->closeFile) {
+		memset(&paw_file, 0, sizeof(paw_file));
+		if(concat_path(paw_file.name, device->initial->name, PAW_QUIPS_PATH) < PATHNAME_MAX) {
+			paw_file.device = device;
+			if(device->readFile(&paw_file, NULL, 0) == 0 && paw_file.size > 0) {
+				u32 want = paw_file.size < PAW_QUIPS_READ_MAX ? (u32)paw_file.size : PAW_QUIPS_READ_MAX;
+				device->seekFile(&paw_file, 0, DEVICE_HANDLER_SEEK_SET);
+				s32 got = device->readFile(&paw_file, paw_buf, want);
+				if(got > 0 && got <= (s32)want) {
+					// a cut-off last line (file larger than the cap) is dropped
+					if(paw_file.size > PAW_QUIPS_READ_MAX) {
+						while(got > 0 && paw_buf[got-1] != '\n' && paw_buf[got-1] != '\r') got--;
+					}
+					paw_buf[got] = '\0';
+					if(got > 0 && paw_is_text(paw_buf, got)) {
+						count = paw_scan_lines(got, starts, lens);
+					}
+				}
+			}
+			device->closeFile(&paw_file);
+		}
+	}
+
+	if(count > 0) {
+		int pick = seed % count;
+		paw_clean_line(paw_quip, starts[pick], lens[pick]);
+		paw_quip_ptr = paw_quip;
+	}
+	else {
+		paw_quip_ptr = paw_builtin[seed % PAW_BUILTIN_COUNT];
+	}
+}
diff --git a/cube/swiss/source/gui/pawtation.h b/cube/swiss/source/gui/pawtation.h
new file mode 100644
index 00000000..957bbf6f
--- /dev/null
+++ b/cube/swiss/source/gui/pawtation.h
@@ -0,0 +1,27 @@
+/* -----------------------------------------------------------
+      pawtation.h - mascot and start-up quip of the private,
+      unofficial "Pawtation" theme. Not part of Swiss and not
+      supported by the Swiss project.
+   ----------------------------------------------------------- */
+
+#ifndef PAWTATION_H
+#define PAWTATION_H
+
+#include "deviceHandler.h"
+
+// 0 turns the mascot and quip off (title bar falls back to plain text).
+#define PAWTATION_MASCOT 1
+
+#define PAW_QUIPS_PATH      "pawtation/quips.txt"
+#define PAW_QUIPS_READ_MAX  4096	// bytes read at most, whatever the file size
+#define PAW_QUIPS_LINES     40		// lines considered at most
+#define PAW_QUIP_CHARS      60		// characters kept per line at most
+
+// Read PAW_QUIPS_PATH once from the boot device and pick one line. Main thread, at boot only.
+// Never blocks on the user, never shows anything, falls back to a built-in quip on any problem.
+void paw_init(DEVICEHANDLER_INTERFACE *device);
+
+// Current quip: static storage, never NULL, safe to call from the video thread.
+const char *paw_quip_current(void);
+
+#endif
