From 825dd07214b3762bf0bfa031ed845de6877af614 Mon Sep 17 00:00:00 2001
From: Pawtation fork <fork@localhost>
Date: Sun, 15 Nov 2026 13:04:43 +0000
Subject: [PATCH 2/4] Pawtation theme (unofficial): title identity and
 info-page notice

Title bar names the unofficial Pawtation theme and the Swiss base it is
built on; the live commit/revision are labelled as the fork's. Info page
4/5 keeps every upstream line and adds one Pawtation notice line. The
load_app failure message no longer points users at the upstream tracker.
---
 cube/swiss/source/gui/FrameBufferMagic.c |  8 ++++----
 cube/swiss/source/gui/info.c             |  2 ++
 cube/swiss/source/gui/pawtation_theme.h  | 11 +++++++++++
 cube/swiss/source/swiss.c                |  2 +-
 4 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/cube/swiss/source/gui/FrameBufferMagic.c b/cube/swiss/source/gui/FrameBufferMagic.c
index 18125cf6..5007a92d 100644
--- a/cube/swiss/source/gui/FrameBufferMagic.c
+++ b/cube/swiss/source/gui/FrameBufferMagic.c
@@ -1513,11 +1513,11 @@ static void _DrawTitleBar(uiDrawObj_t *evt) {
 	
 	_DrawSimpleBox(19, 17, 602, 62, 0, fillColor, noColor);
 	
-	_DrawImageNow(TEX_SWISS, 36, 32, 96, 32, 0, 0.0f, 1.0f, 0.0f, 1.0f, 0);
-	drawString(142, 39, "for GameCube", 0.55f, ALIGN_LEFT, defaultColor);
-	drawString(142, 56, "version 0.6", 0.55f, ALIGN_LEFT, defaultColor);
+	_DrawImageNow(TEX_SWISS, PAW_LOGO_X, PAW_LOGO_Y, 96, 32, 0, 0.0f, 1.0f, 0.0f, 1.0f, 0);
+	drawString(PAW_ROW1_X, 39, PAW_NAME, 0.75f, ALIGN_LEFT, defaultColor);
+	drawString(PAW_LOGO_X, PAW_BASED_ON_Y, PAW_BASED_ON, GetTextScaleToFitInWidthWithMax(PAW_BASED_ON, 270, 0.45f), ALIGN_LEFT, defaultColor);
 	
-	sprintf(fbTextBuffer, "commit: %s \267 revision: %s", GIT_COMMIT, GIT_REVISION);
+	sprintf(fbTextBuffer, "fork commit: %s \267 fork rev: %s", GIT_COMMIT, GIT_REVISION);
 	drawString(getVideoMode()->fbWidth-36, 56, fbTextBuffer, 0.55f, ALIGN_RIGHT, defaultColor);
 	
 	s8 cputemp = SYS_GetCoreTemperature();
diff --git a/cube/swiss/source/gui/info.c b/cube/swiss/source/gui/info.c
index 3293133b..085108bd 100644
--- a/cube/swiss/source/gui/info.c
+++ b/cube/swiss/source/gui/info.c
@@ -19,6 +19,7 @@
 #include "flippy.h"
 #include "gcloader.h"
 #include "wkf.h"
+#include "pawtation_theme.h"
 
 const float exiSpeeds[] = {
 	27.0f/32.0f,
@@ -315,6 +316,7 @@ uiDrawObj_t * info_draw_page(int page_num) {
 		sprintf(topStr, "Commit %s; Revision %s", GIT_COMMIT, GIT_REVISION);
 		DrawAddChild(container, DrawStyledLabel(640/2, 165, topStr, 0.75f, ALIGN_CENTER, defaultColor));
 		DrawAddChild(container, DrawStyledLabel(640/2, 190, "Built with " _V_STRING, 0.64f, ALIGN_CENTER, defaultColor));
+		DrawAddChild(container, DrawStyledLabel(640/2, 215, PAW_INFO_LINE, GetTextScaleToFitInWidthWithMax(PAW_INFO_LINE, 560, 0.64f), ALIGN_CENTER, defaultColor));
 		DrawAddChild(container, DrawStyledLabel(640/2, 240, "Source/Updates/Issues", 0.75f, ALIGN_CENTER, defaultColor));
 		DrawAddChild(container, DrawStyledLabel(640/2, 264, "github.com/emukidid/swiss-gc", 0.64f, ALIGN_CENTER, defaultColor));
 		DrawAddChild(container, DrawStyledLabel(640/2, 310, "Web/Support", 0.75f, ALIGN_CENTER, defaultColor));
diff --git a/cube/swiss/source/gui/pawtation_theme.h b/cube/swiss/source/gui/pawtation_theme.h
index a4ad445a..f4955654 100644
--- a/cube/swiss/source/gui/pawtation_theme.h
+++ b/cube/swiss/source/gui/pawtation_theme.h
@@ -44,4 +44,15 @@
 /* Backdrop TEV channel selector for IA8-palette art (see _DrawImageNow) */
 #define PAW_BACKDROP_SELECT    (GXColor) {255,0,255,255}    /* {0,0,255,255} */
 
+/* Identity. Upstream name, authors, version and licence stay as they are. */
+#define PAW_NAME               "Pawtation"
+#define PAW_BASED_ON           "unofficial theme, based on Swiss 0.6 r2119"
+#define PAW_INFO_LINE          "Pawtation theme: private, unofficial, not supported by the Swiss project"
+
+/* Title bar layout (logical 640x480; title box spans x 15..625, y 13..83) */
+#define PAW_LOGO_X             88
+#define PAW_LOGO_Y             22
+#define PAW_BASED_ON_Y         66
+#define PAW_ROW1_X             192
+
 #endif
diff --git a/cube/swiss/source/swiss.c b/cube/swiss/source/swiss.c
index 3ab34d0a..eac9a660 100644
--- a/cube/swiss/source/swiss.c
+++ b/cube/swiss/source/swiss.c
@@ -1228,7 +1228,7 @@ void load_app(ExecutableFile *fileToPatch)
 			message = "Exhausted reserved memory.\nAn SD Card Adapter is necessary in order\nfor patches to reserve additional memory.";
 			goto fail;
 		default:
-			message = "Something went wrong.\nPlease open an issue with your hardware\nconfiguration and Swiss settings.";
+			message = "Something went wrong.\nThis is an unofficial themed build: retry\nwith stock Swiss before reporting anything.";
 			goto fail;
 	}
 	setTopAddr(topAddr);
-- 
