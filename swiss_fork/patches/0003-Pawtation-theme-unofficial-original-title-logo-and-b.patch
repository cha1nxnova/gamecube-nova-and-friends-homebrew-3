From 1d813f215b8b3f7a947b222dfa48beb0b27a08b7 Mon Sep 17 00:00:00 2001
From: Pawtation fork <fork@localhost>
Date: Sun, 15 Nov 2026 13:09:50 +0000
Subject: [PATCH 3/4] Pawtation theme (unofficial): original title logo and
 backdrop

New art generated by the Pawtation project's swiss_fork/art/make_art.py:
pawlogo.png (96x32, I4, tinted in code) replaces the title logo and
pawbackdrop.png (640x480, CMPR, untiled) replaces the built-in backdrop.
The stock swiss/backdrop.tpl override on the boot device still works.
---
 cube/swiss/source/gui/FrameBufferMagic.c |   7 +++----
 cube/swiss/source/gui/pawtation_theme.h  |   1 +
 cube/swiss/source/images/images.scf      |   4 ++--
 cube/swiss/source/images/pawbackdrop.png | Bin 0 -> 40791 bytes
 cube/swiss/source/images/pawlogo.png     | Bin 0 -> 1098 bytes
 5 files changed, 6 insertions(+), 6 deletions(-)
 create mode 100644 cube/swiss/source/images/pawbackdrop.png
 create mode 100644 cube/swiss/source/images/pawlogo.png

diff --git a/cube/swiss/source/gui/FrameBufferMagic.c b/cube/swiss/source/gui/FrameBufferMagic.c
index 5007a92d..7bf1b8ef 100644
--- a/cube/swiss/source/gui/FrameBufferMagic.c
+++ b/cube/swiss/source/gui/FrameBufferMagic.c
@@ -333,10 +333,9 @@ static void init_textures()
 {
 	TPL_OpenTPLFromMemory(&imagesTPL, (void *)images_tpl, images_tpl_size);
 	TPL_OpenTPLFromMemory(&buttonsTPL, (void *)buttons_tpl, buttons_tpl_size);
-	TPL_GetTextureCI(&imagesTPL, backdrop, &backdropTexObj, &backdropTlutObj, GX_TLUT0);
-	GX_InitTexObjUserData(&backdropTexObj, &backdropTlutObj);
+	TPL_GetTexture(&imagesTPL, backdrop, &backdropTexObj);
 	TPL_GetTexture(&imagesTPL, backdrop_ind, &backdropIndTexObj);
-	GX_InitTexObjUserData(&backdropIndTexObj, &backdropTexObj);
+	GX_InitTexObjUserData(&backdropIndTexObj, NULL);
 	TPL_GetTexture(&imagesTPL, banner_mask, &bannerMaskTexObj);
 	TPL_GetTexture(&imagesTPL, swissimg, &swissTexObj);
 	TPL_GetTexture(&imagesTPL, gcdvdsmall, &gcdvdsmallTexObj);
@@ -522,7 +521,7 @@ static void _DrawImageNow(int textureId, int x, int y, int width, int height, in
 			}
 			break;
 		case TEX_SWISS:
-			texObj = &swissTexObj;
+			texObj = &swissTexObj; color = PAW_LOGO_TINT;
 			break;
 		case TEX_GCDVDSMALL:
 			texObj = &gcdvdsmallTexObj;
diff --git a/cube/swiss/source/gui/pawtation_theme.h b/cube/swiss/source/gui/pawtation_theme.h
index f4955654..0546ba37 100644
--- a/cube/swiss/source/gui/pawtation_theme.h
+++ b/cube/swiss/source/gui/pawtation_theme.h
@@ -31,6 +31,7 @@
 #define PAW_SELECT_ROW(a)      (GXColor) {176,38,112,(a)}   /* {46,57,104,a} file rows */
 #define PAW_SCROLL_THUMB(a)    (GXColor) {255,79,163,(a)}   /* {46,57,104,a} */
 #define PAW_MENU_GLOW          (GXColor) {255,79,163,255}   /* {127,134,255,255} */
+#define PAW_LOGO_TINT          (GXColor) {255,79,163,255}   /* {255,255,255,255} (art: images/pawlogo.png) */
 
 /* Progress */
 #define PAW_PROGRESS(a)        (GXColor) {255,79,163,(a)}   /* {255,128,0,a} */
diff --git a/cube/swiss/source/images/images.scf b/cube/swiss/source/images/images.scf
index c934bf7c..29474bbe 100644
--- a/cube/swiss/source/images/images.scf
+++ b/cube/swiss/source/images/images.scf
@@ -1,4 +1,4 @@
-<filepath="backdrop.png" id="backdrop" colfmt=8 palfmt=0 magfilt=0 />
+<filepath="pawbackdrop.png" id="backdrop" colfmt=14 />
 <filepath="backdrop_ind.png" id="backdrop_ind" colfmt=3 minfilt=0 magfilt=0 />
 <filepath="banner_mask.tif" id="banner_mask" colfmt=0 />
 <filepath="bba.tif" id="bbaimg" colfmt=3 />
@@ -26,7 +26,7 @@
 <filepath="qoob.png" id="qoobimg" colfmt=9 palfmt=0 magfilt=0 />
 <filepath="qoob_ind.png" id="qoobimg_ind" colfmt=1 minfilt=0 magfilt=0 />
 <filepath="sdsmall.tif" id="sdsmall" colfmt=9 palfmt=0 />
-<filepath="swiss.tif" id="swissimg" colfmt=0 />
+<filepath="pawlogo.png" id="swissimg" colfmt=0 />
 <filepath="systemimg.tif" id="systemimg" colfmt=3 />
 <filepath="tgc.tif" id="tgcimg" colfmt=6 />
 <filepath="usbgecko.tif" id="usbgeckoimg" colfmt=9 palfmt=0 />
